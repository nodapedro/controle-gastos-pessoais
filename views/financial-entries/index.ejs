<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lançamentos financeiros</title>
</head>
<body>
    <h1>Meus lançamentos</h1>

    <% if (error) { %>
        <p role="alert"><%= error %></p>
    <% } %>

    <nav>
        <a href="/">Voltar ao início</a><br>
        <a href="/categories">Gerenciar categorias</a><br>
        <a href="/entries/new">Novo lançamento</a>
    </nav>

    <h2>Filtrar lançamentos</h2>

    <form action="/entries" method="GET">
        <div>
            <label for="from">Data inicial</label>
            <input
                type="date"
                id="from"
                name="from"
                value="<%= from %>"
            >
        </div>

        <div>
            <label for="to">Data final</label>
            <input
                type="date"
                id="to"
                name="to"
                value="<%= to %>"
            >
        </div>

        <div>
            <label for="categoryId">Categoria</label>
            <select id="categoryId" name="categoryId">
                <option value="">Todas as categorias</option>

                <% categories.forEach(category => { %>
                    <option
                        value="<%= category.id %>"
                        <%= categoryId === category.id ? "selected" : "" %>
                    >
                        <%= category.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Filtrar</button>
        <a href="/entries">Limpar filtros</a>
    </form>

    <h2>Resultados</h2>

    <% if (entries.length === 0) { %>
        <p>Nenhum lançamento encontrado.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                <% entries.forEach(entry => { %>
                    <tr>
                        <td><%= formatDate(entry.entryDate) %></td>
                        <td><%= entry.description %></td>
                        <td><%= entry.category.name %></td>

                        <td>
                            <%= entry.entryType === "income"
                                ? "Receita"
                                : "Despesa" %>
                        </td>

                        <td>R$ <%= entry.amount %></td>

                        <td>
                            <a href="/entries/<%= entry.id %>/edit">
                                Editar
                            </a>

                            <form
                                action="/entries/<%= entry.id %>/delete"
                                method="POST"
                                style="display: inline;"
                                onsubmit="return confirm('Deseja excluir este lançamento?');"
                            >
                                <button type="submit">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</body>
</html>